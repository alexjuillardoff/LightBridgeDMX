generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Fixture {
  id        String  @id
  name      String
  address   Int
  universe  Int
  channels  String  // JSON: FixtureChannel[]
  createdAt String
  profile   String? // JSON: { source, manufacturer, model, mode }
  homekit   String? // JSON: FixtureHomeKit
  room      String?
}

model DanceConfig {
  id            String  @id @default("singleton")
  enabled       Boolean @default(false)
  rooms         String  // JSON: string[]
  intervalMinMs Int     @default(55)
  intervalMaxMs Int     @default(140)
  patterns      String  // JSON: string[]
  excludePanTilt Boolean @default(true)
  excludeCapabilities String // JSON: string[]
  lyre          String  @default("{\"enabled\":false,\"shutterOpenValue\":255,\"dimmerOnValue\":255,\"followChase\":false,\"positions\":[],\"wallEdgeRight\":{\"pan\":20,\"tilt\":9},\"speedValue\":0,\"msPerPanUnit\":40}") // JSON: DanceLyreMode
  updatedAt     String
}

model Scene {
  id    String @id
  name  String
  steps String // JSON: { fixtureId, values }[]
}

model Preset {
  id      String @id
  name    String
  payload String // JSON: Record<string, number>
}

model SmartLight {
  id            String  @id
  name          String
  room          String?
  backend       String  // "nanoleaf-http" — extensible (Matter, hap-controller…)
  config        String  // JSON: backend-specific config (host, token, deviceId…)
  dmxMirror     String? // JSON: SmartLightDmxMirror | null
  streaming     String? // JSON: SmartLightStreaming | null
  zoneLayout    String? // JSON: SmartLightZoneLayout | null
  currentEffect String? // JSON: SmartLightEffectConfig | null
  createdAt     String
}
