generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Fixture {
  id        String  @id
  name      String
  address   Int
  universe  Int
  channels  String  // JSON: FixtureChannel[]
  createdAt String
  profile   String? // JSON: { source, manufacturer, model, mode }
  homekit   String? // JSON: FixtureHomeKit
  room      String?
}

model Scene {
  id    String @id
  name  String
  steps String // JSON: { fixtureId, values }[]
}

model Preset {
  id      String @id
  name    String
  payload String // JSON: Record<string, number>
}

// Configuration de la prise Meross pilotee en local (LAN). Ligne unique "singleton".
// Source de verite pour l'IP, la device key et le canal ; remplace la config par env.
model MerossConfig {
  id        String  @id @default("singleton")
  enabled   Boolean @default(false)
  host      String  @default("")
  key       String  @default("")
  channel   Int     @default(0)
  updatedAt String
}

model SmartLight {
  id            String  @id
  name          String
  room          String?
  backend       String  // "nanoleaf-http" — extensible (Matter, hap-controller…)
  config        String  // JSON: backend-specific config (host, token, deviceId…)
  dmxMirror     String? // JSON: SmartLightDmxMirror | null
  streaming     String? // JSON: SmartLightStreaming | null
  zoneLayout    String? // JSON: SmartLightZoneLayout | null
  currentEffect String? // JSON: SmartLightEffectConfig | null
  createdAt     String
}

// Last known DMX universe values, restored at backend startup so projectors
// keep their state across restarts. Singleton row per universe id.
model UniverseSnapshot {
  universe  Int    @id
  values    Bytes  // 512 bytes, channel 1 at index 0
  updatedAt String
}
